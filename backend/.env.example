# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/multi_vendor_marketplace

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin (used by `npm run seed`)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# AWS S3 (product images)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key
AWS_BUCKET_NAME=replace_with_bucket_name

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_replace_with_actual_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_actual_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_actual_secret

# Razorpay Payment
RAZORPAY_KEY_ID=rzp_test_replace_with_actual_key_id
RAZORPAY_KEY_SECRET=rzp_test_replace_with_actual_secret
